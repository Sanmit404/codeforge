# Model. Format is provider/model. Supported providers: openrouter, openai,
# anthropic, google.
LLM_MODEL=openrouter/openai/gpt-4o-mini
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# The only directory the agent is allowed to read, index, or write.
REPOSITORY_ROOT=/absolute/path/to/the/python/repository

# Needed only for the github MCP server. A fine grained token is enough.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Where the Chroma index lives.
INDEX_PATH=.codeforge/chroma

# How many times the coder may retry after a failed validation before the
# orchestrator has to step in.
MAX_VALIDATION_ATTEMPTS=2

# JSONL run log used by telemetry.summarize.
RUN_LOG=run_log.jsonl
