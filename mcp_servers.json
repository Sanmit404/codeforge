{
  "servers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${REPOSITORY_ROOT}"]
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "${REPOSITORY_ROOT}"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "repository-index": {
      "command": "uv",
      "args": ["run", "python", "-m", "codeforge.retrieval.server"],
      "env": {
        "REPOSITORY_ROOT": "${REPOSITORY_ROOT}"
      }
    },
    "validation": {
      "command": "uv",
      "args": ["run", "python", "-m", "codeforge.validation.server"],
      "env": {
        "REPOSITORY_ROOT": "${REPOSITORY_ROOT}"
      }
    }
  }
}
